{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard de Rematrículas Journey — Recebimento",
    "version": "4.6.0",
    "description": "Recebe requerimentos como o Fluent Forms: confirma RA já cadastrado e ativo, preservando primeira data, valores, conferências e arquivamento. Somente HTTPS. Não cria alunos nem permite leitura de finanças. Limite de 1 MiB por chamada. Veja API-REMATRICULAS.md. Logs administrativos e controle persistente de reenvios por identidade. Respostas de itens incluem log_id quando disponível."
  },
  "servers": [
    {
      "url": "/wp-json/drj/v1",
      "description": "Use a URL REST exibida nas configurações do WordPress."
    }
  ],
  "security": [
    {
      "ChaveDRJ": []
    }
  ],
  "paths": {
    "/rematriculas": {
      "post": {
        "operationId": "receberRematriculas",
        "summary": "Confirmar recebimento de requerimentos por RA",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Rematricula"
                  },
                  {
                    "$ref": "#/components/schemas/RequerimentoERP"
                  },
                  {
                    "$ref": "#/components/schemas/DetalheERP"
                  },
                  {
                    "$ref": "#/components/schemas/Lote"
                  }
                ]
              },
              "examples": {
                "simples": {
                  "value": {
                    "ra": "000123",
                    "data_rematricula": "2026-11-13T13:00:00Z"
                  }
                },
                "lote": {
                  "value": {
                    "items": [
                      {
                        "ra": "000123"
                      },
                      {
                        "ra": "000456"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmação, reenvio ou item ignorado; consulte situacao.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Resultado"
                    },
                    {
                      "$ref": "#/components/schemas/ResultadoLote"
                    }
                  ]
                }
              }
            }
          },
          "207": {
            "description": "Lote com falhas individuais; sucessos permanecem salvos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoLote"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Chave ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS obrigatório",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "RA não cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "RA duplicado, requerimento vinculado a outro RA, conflito ou coligada não configurada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "413": {
            "description": "Corpo maior que 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type deve ser application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Campos ou contrato inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Banco pendente ou falha de consulta/gravação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,100}$"
            },
            "description": "Alternativa ao id_requerimento em envios simples; em lotes use um ID por item."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ChaveDRJ": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DRJ-Key",
        "description": "Chave cadastrada em Dash Rematrículas → Configurações → Acesso e integração. Não use a senha de aplicativo do ERP aqui."
      }
    },
    "schemas": {
      "Rematricula": {
        "type": "object",
        "required": [
          "ra"
        ],
        "properties": {
          "ra": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "RA exato; preserve zeros iniciais.",
            "examples": [
              "000123"
            ]
          },
          "data_rematricula": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              },
              {
                "const": ""
              }
            ],
            "description": "Data com fuso. Ausente/vazia: horário do recebimento."
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "aprovado",
              "rejeitado"
            ],
            "description": "Rejeitado é ignorado. Demais situações confirmam o recebimento."
          },
          "id_requerimento": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "description": "Identificador estável; repita o mesmo valor nos reenvios. Sem ID, usa o RA."
          },
          "sistema_origem": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$",
            "default": "externo"
          }
        },
        "additionalProperties": true
      },
      "RequerimentoERP": {
        "type": "object",
        "required": [
          "idrequerimento",
          "codcoligada",
          "versao",
          "status"
        ],
        "properties": {
          "idrequerimento": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "codcoligada": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "versao": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "aprovado",
              "rejeitado"
            ]
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "resultado": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "ra": {
                "type": "string"
              }
            }
          },
          "dados": {
            "type": "object",
            "description": "RA no caminho explícito configurado, caso resultado.ra não exista."
          }
        },
        "description": "Item da API ERP Educacional 0.19.23. Coligada e caminho do RA configurados no dashboard. criado_em é exigido para itens não rejeitados.",
        "additionalProperties": true
      },
      "DetalheERP": {
        "type": "object",
        "required": [
          "item"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "item": {
            "$ref": "#/components/schemas/RequerimentoERP"
          }
        }
      },
      "Lote": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Rematricula"
                },
                {
                  "$ref": "#/components/schemas/RequerimentoERP"
                }
              ]
            }
          }
        }
      },
      "Resultado": {
        "type": "object",
        "required": [
          "situacao",
          "alterado"
        ],
        "properties": {
          "ra": {
            "type": "string"
          },
          "situacao": {
            "enum": [
              "confirmado",
              "ja_confirmado",
              "arquivado",
              "rejeitado",
              "sem_ra",
              "anterior_ao_periodo",
              "versao_antiga"
            ]
          },
          "alterado": {
            "type": "boolean"
          },
          "data_rematricula": {
            "type": [
              "string",
              "null"
            ],
            "description": "Data local no fuso WordPress, AAAA-MM-DD HH:MM:SS."
          },
          "log_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Referência ao registro administrativo."
          },
          "duplicado": {
            "type": "boolean",
            "description": "Requerimento aceito anteriormente; nenhuma nova confirmação foi aplicada."
          }
        }
      },
      "ResultadoLote": {
        "type": "object",
        "required": [
          "erros",
          "resultados"
        ],
        "properties": {
          "erros": {
            "type": "integer",
            "minimum": 0
          },
          "resultados": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "indice",
                "sucesso"
              ],
              "properties": {
                "indice": {
                  "type": "integer",
                  "minimum": 0
                },
                "sucesso": {
                  "type": "boolean"
                },
                "situacao": {
                  "enum": [
                    "confirmado",
                    "ja_confirmado",
                    "arquivado",
                    "rejeitado",
                    "sem_ra",
                    "anterior_ao_periodo"
                  ]
                },
                "ra": {
                  "type": "string"
                },
                "alterado": {
                  "type": "boolean"
                },
                "data_rematricula": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Data local no fuso WordPress, AAAA-MM-DD HH:MM:SS."
                },
                "codigo": {
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                },
                "http_status": {
                  "type": "integer"
                },
                "log_id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Referência ao registro administrativo."
                },
                "duplicado": {
                  "type": "boolean",
                  "description": "Requerimento aceito anteriormente; nenhuma nova confirmação foi aplicada."
                }
              }
            }
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              },
              "log_id": {
                "type": "integer",
                "minimum": 1,
                "description": "Referência ao registro administrativo."
              }
            }
          }
        }
      }
    }
  }
}
